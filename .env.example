# ---- Database ----
DATABASE_URL=postgres://user:pass@localhost:5432/linq_stellar?sslmode=disable

# ---- Stellar ----
# Horizon endpoint. Pubnet by default; use horizon-testnet.stellar.org for testnet.
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Circle's USDC issuer on pubnet. Override for testnet, where USDC is a
# different issuer entirely and a payment to the wrong one is unrecoverable.
STELLAR_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Sponsor account seed (S...). Pays the base reserves for every single-use
# deposit account and gets them all back when the account is merged on sweep.
# This key can move funds: it is the one secret in this service that matters.
STELLAR_SPONSOR_KEY=

# Treasury account (G...) that swept USDC is sent to. Must already hold a
# USDC trustline or every sweep fails.
STELLAR_TREASURY_WALLET=

# ---- Deposit detection ----
# The polling sweep is a backstop behind the Horizon stream, not a replacement:
# it catches deposits the stream dropped across a reconnect.
STELLAR_SCAN_INTERVAL=15s
STELLAR_DEPOSIT_WINDOW=30m

# ---- NGN payout ----
# Payout is delegated to the Linq B2B API, which already disburses NGN for
# every other chain. This service never talks to a bank or payout partner.
LINQ_API_URL=https://confidential-brianna-uselinq-52e2b233.koyeb.app
LINQ_INTERNAL_SECRET=

# ---- SEP-10 ----
# Domain this service authenticates for; must match the stellar.toml host.
SEP10_HOME_DOMAIN=
# Server signing key (S...) advertised as SIGNING_KEY in stellar.toml.
SEP10_SIGNING_KEY=
SEP10_JWT_SECRET=
SEP10_CHALLENGE_TIMEOUT=300s

# ---- Server ----
PORT=8080
LOG_LEVEL=info
