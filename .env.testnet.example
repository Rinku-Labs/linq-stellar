# Settings for the test deployment (SD-7): the Stellar test network and a fake
# payout provider. Nothing here can move real money.
#
# 1. Copy this file to .env.
# 2. Run testnet-setup and add the lines it prints (the sponsor and treasury
#    accounts, and every secret) to the end of .env.
# DEPLOYMENT.md, "Test mode", has the whole procedure.

# ---- Database ----
# docker-compose.yml points the server and worker at its own Postgres. Set this
# yourself anywhere else.
DATABASE_URL=postgres://linq:linq@db:5432/linq_stellar?sslmode=disable

# ---- Stellar test network ----
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Circle's testnet USDC: the asset faucet.circle.com hands out.
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_DEPOSIT_WINDOW=30m

# ---- Test mode ----
# Every payout is reported paid and no naira is sent. Refused on mainnet.
PAYOUT_PROVIDER=fake
# Naira per USDC that test orders are quoted at. At 1500, a 1,500 naira order
# asks for 1.00 USDC, and the faucet's 10 USDC pays for several.
TEST_RATE_NGN=1500
# Show a retry as a new payout under its own reference (<order>-p2).
PAYOUT_NEW_REFERENCE_ON_RETRY=true

# ---- Public API ----
PUBLIC_API_ENABLED=true

# ---- Reconciliation ----
# Often, so a reviewer sees their order checked within minutes.
RECONCILE_INTERVAL=2m
# This sponsor is used by nothing else, so every account it pays for must have
# an order or a pool row behind it.
RECONCILE_SPONSORED_ACCOUNTS=true

# ---- Linq-B2B ----
# There is no Linq-B2B on the test network. Leave both empty.
MERCHANT_WEBHOOK_URL=
MERCHANT_WEBHOOK_SECRET=

# ---- Organisation (published in stellar.toml) ----
ORG_NAME=Linq (test network)

# ---- Server ----
PORT=8080
LOG_LEVEL=info

# ---- Added by testnet-setup ----
# STELLAR_SPONSOR_KEY, STELLAR_TREASURY_WALLET, ENCRYPTION_KEY, ORDERS_API_KEY,
# ADMIN_API_KEY, REVIEWER_TOKEN
